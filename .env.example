# 設定値の見本です。実際のキーはこのファイルに書かないでください。
#
# ■ 画面側（VITE_ で始まる値）
#   ビルド時に画面のファイルへ埋め込まれ、誰でも見られます。秘密の値は絶対に入れないでください。
#   静的版（楽天・Yahoo!・eBay と連携しない版）は npm run build:static で作ります（設定不要）。
#
# ■ サーバー側（/api/rakuten・/api/yahoo・/api/ebay だけが読む値）
#   本番: Cloudflare Workers のシークレットに登録します（例: npx wrangler secret put SERVER_RAKUTEN_APP_ID）。
#   手元: source/ 直下の .dev.vars に「名前=値」で書きます（.dev.vars は Git・納品物に含まれません）。
#   設定していないサイトは、画面に理由を表示して他のサイトの結果だけを出します（アプリは落ちません）。

# 楽天市場（2026年〜の新API。アプリIDとアクセスキーの両方が必要）
SERVER_RAKUTEN_APP_ID=
SERVER_RAKUTEN_ACCESS_KEY=
# 楽天の「許可されたWebサイト」と公開URLが違う場合（独自ドメイン・手元での確認）だけ指定します。例: https://shop.example.com
SERVER_RAKUTEN_ALLOWED_ORIGIN=

# Yahoo!ショッピング（Yahoo!デベロッパーネットワークの Client ID）
SERVER_YAHOO_CLIENT_ID=

# eBay（eBay Developers Program の Production の App ID と Cert ID）
SERVER_EBAY_CLIENT_ID=
SERVER_EBAY_CLIENT_SECRET=
# 検索する eBay のマーケット（既定 EBAY_US。価格は USD）
SERVER_EBAY_MARKETPLACE_ID=
