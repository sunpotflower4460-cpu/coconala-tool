{
  "name": "coconala-tool",
  "private": true,
  "version": "1.0.0-beta.2",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "SEE LICENSE IN TERMS.md",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "build:static": "vite build --mode static --outDir dist-static",
    "preview": "vite preview",
    "lint": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:postdeploy": "playwright test --grep @postdeploy --project desktop-chromium",
    "delivery:package": "node scripts/create-delivery-package.mjs",
    "deploy": "npm run build && wrangler deploy",
    "delivery:verify": "node scripts/verify-delivery.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "marketing:capture": "npm run build:desktop && playwright test --config scripts/playwright.marketing.config.ts",
    "build:local": "npm run build:static && node scripts/build-local-html.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "desktop": "node scripts/build-desktop.mjs && electron dist-desktop",
    "e2e:desktop": "playwright test --config playwright.desktop.config.ts",
    "dist:desktop:mac": "npm run build:desktop && electron-builder --mac --config electron-builder.yml",
    "dist:desktop:win": "npm run build:desktop && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.59.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.11",
    "wrangler": "^4.138.0"
  }
}
