{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coconala-tool",
  "compatibility_date": "2026-09-01",
  "main": "./worker.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // /api/*（楽天・Yahoo!ショッピング・eBay）の濫用対策。1利用者（IP）あたり 60 秒に 60 回まで（まとめて検索で約20回）。超えると 429。
  // namespace_id はアカウント内で一意な正の整数（他の Worker と重ならなければ変更不要）。
  "ratelimits": [
    {
      "name": "RAKUTEN_RATE_LIMITER",
      "namespace_id": "43173",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  // 楽天のキーは vars ではなく Secret で設定する（docs/deployment-guide.md 参照）:
  //   npx wrangler secret put SERVER_RAKUTEN_APP_ID
  //   npx wrangler secret put SERVER_RAKUTEN_ACCESS_KEY
  //   npx wrangler secret put SERVER_YAHOO_CLIENT_ID
  //   npx wrangler secret put SERVER_EBAY_CLIENT_ID
  //   npx wrangler secret put SERVER_EBAY_CLIENT_SECRET
  "env": {
    // 自動テスト専用（`npm run e2e`）。ローカルの偽楽天サーバーへ向ける。本番デプロイでは使われない。
    "e2e": {
      "ratelimits": [
        {
          "name": "RAKUTEN_RATE_LIMITER",
          "namespace_id": "43174",
          "simple": { "limit": 1000, "period": 60 }
        }
      ],
      "vars": {
        "SERVER_RAKUTEN_APP_ID": "e2e-dummy-app-id",
        "SERVER_RAKUTEN_ACCESS_KEY": "e2e-dummy-access-key",
        "E2E_FAKE_UPSTREAM": "1",
        "RAKUTEN_API_BASE_OVERRIDE": "http://127.0.0.1:43174/ichibams/api/IchibaItem/Search/20260701",
        "SERVER_YAHOO_CLIENT_ID": "e2e-dummy-yahoo-client",
        "YAHOO_API_BASE_OVERRIDE": "http://127.0.0.1:43174/ShoppingWebService/V3/itemSearch",
        "SERVER_EBAY_CLIENT_ID": "e2e-dummy-ebay-client",
        "SERVER_EBAY_CLIENT_SECRET": "e2e-dummy-ebay-secret",
        "EBAY_API_BASE_OVERRIDE": "http://127.0.0.1:43174/buy/browse/v1/item_summary/search",
        "EBAY_OAUTH_URL_OVERRIDE": "http://127.0.0.1:43174/identity/v1/oauth2/token"
      }
    }
  }
}
