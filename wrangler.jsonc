{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coconala-tool",
  "compatibility_date": "2026-09-01",
  "main": "./worker.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": ["nodejs_compat"]
}
